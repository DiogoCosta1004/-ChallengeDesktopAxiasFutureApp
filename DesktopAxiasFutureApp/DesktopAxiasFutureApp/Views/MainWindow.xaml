<Window x:Class="DesktopAxiasFutureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axias Futures App" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Login Section -->
        <Border Grid.Row="0" Padding="10" Background="#FFFFEEEE">
            <!-- Cor corrigida aqui -->
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtUsername" Width="120" Margin="5" />
                <PasswordBox x:Name="txtPassword" Width="120" Margin="5" />
                <Button x:Name="btnLogin" Content="Login" Margin="5" Padding="10,5" Click="btnLogin_Click"/>
                <TextBlock x:Name="lblLoginStatus" Margin="5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Messages Feed -->
            <ListBox x:Name="lstMessages" Margin="10"/>

            <!-- Controls -->
            <StackPanel Grid.Column="1" Width="200" Margin="10">
                <Button x:Name="btnRead" Content="Ler Mensagem" 
                        Margin="0,0,0,10" Height="30"
                        Click="btnRead_Click"/>

                <Button x:Name="btnStop" Content="Parar Leitura" 
                        Margin="0,0,0,20" Height="30"
                        Click="btnStop_Click"/>

                <TextBlock Text="Volume:" Margin="0,0,0,5"/>
                <Slider x:Name="sldVolume" Minimum="0" Maximum="100" 
                        Value="50" TickFrequency="10"
                        ValueChanged="sldVolume_ValueChanged"/>

                <TextBlock x:Name="lblConnectionStatus" Margin="0,20,0,0" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
